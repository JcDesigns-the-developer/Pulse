#!/usr/bin/env bash
set -u

ok=0
warn=0
fail=0

pass() { printf '  [OK]   %s\n' "$1"; ok=$((ok + 1)); }
warn() { printf '  [WARN] %s\n' "$1"; warn=$((warn + 1)); }
fail() { printf '  [FAIL] %s\n' "$1"; fail=$((fail + 1)); }

printf '== Pulse Doctor ==\n\n'

for cmd in hyprland hyprctl start-hyprland waybar rofi kitty mako nmcli iwctl swww wl-copy; do
  if command -v "$cmd" >/dev/null 2>&1; then
    pass "$cmd is installed"
  else
    warn "$cmd is missing"
  fi
done

for file in \
  "$HOME/.config/hypr/hyprland.lua" \
  "$HOME/.config/hypr/hypridle.conf" \
  "$HOME/.config/hypr/hyprlock.conf" \
  "$HOME/.config/hypr/pulse/theme.lua" \
  "$HOME/.config/hypr/pulse/settings.lua" \
  "$HOME/.config/hypr/pulse/binds.lua" \
  "$HOME/.config/hypr/pulse/rules.lua" \
  "$HOME/.config/waybar/config.jsonc" \
  "$HOME/.config/waybar/style.css" \
  "$HOME/.config/rofi/config.rasi" \
  "$HOME/.config/kitty/kitty.conf" \
  "$HOME/.config/pulse/settings.conf" \
  "$HOME/.config/pulse/theme.conf" \
  "$HOME/.config/pulse/pulse.conf" \
  "$HOME/.config/hypr/wallpapers/pulse-ghost.svg"; do
  if [[ -f "$file" ]]; then
    pass "${file#$HOME/} exists"
  else
    fail "Missing ${file#$HOME/}"
  fi
done

if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  pass "XDG_RUNTIME_DIR is set to $XDG_RUNTIME_DIR"
else
  fail "XDG_RUNTIME_DIR is not set"
fi

if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
  pass "WAYLAND_DISPLAY is set to $WAYLAND_DISPLAY"
else
  warn "WAYLAND_DISPLAY is not set; doctor is probably running outside the desktop session"
fi

if [[ -d "$HOME/.config/hypr" ]] && grep -Rni --include='*.conf' 'togglesplit' "$HOME/.config/hypr" >/dev/null 2>&1; then
  warn "legacy togglesplit text remains in a .conf file; it is ignored by the Lua config but can confuse older fallbacks"
else
  pass "no legacy togglesplit binding found"
fi

if [[ -f "$HOME/.config/systemd/user/pulse-update.timer" ]]; then
  pass "Pulse update timer file exists"
else
  warn "Pulse update timer file is missing"
fi

if [[ -f "$HOME/.config/systemd/user/timers.target.wants/pulse-update.timer" ]]; then
  pass "Pulse update timer is enabled"
else
  warn "Pulse update timer is not enabled"
fi

if command -v luac >/dev/null 2>&1; then
  lua_fail=0
  while IFS= read -r file; do
    if ! luac -p "$file" >/dev/null 2>&1; then
      fail "Lua syntax error: ${file#$HOME/}"
      lua_fail=1
    fi
  done < <(find "$HOME/.config/hypr" -type f -name '*.lua' 2>/dev/null)
  (( lua_fail == 0 )) && pass "Lua syntax checks passed"
else
  warn "luac is not installed; Lua syntax was not checked"
fi

printf '\nSummary: %d OK, %d warnings, %d failures\n' "$ok" "$warn" "$fail"

if (( fail > 0 )); then
  printf 'Recommended repair: pulse fix/update\n'
  exit 1
fi

printf 'Pulse baseline checks passed.\n'
