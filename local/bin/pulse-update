#!/usr/bin/env bash
set -euo pipefail

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pulse"
LOG_FILE="$LOG_DIR/update.log"
MODE="update"

for arg in "$@"; do
  case "$arg" in
    -u|--update|-update) MODE="update" ;;
    -f|--fix|-fix|-fix/update) MODE="fix" ;;
    -h|--help|-help)
      cat <<'EOF'
Pulse updater

Usage:
  pulse-update                 Update the Pulse checkout and verify links
  pulse-update -update         Same as the normal update
  pulse-update -fix            Repair Pulse symlinks and managed permissions
  pulse-update -fix/update     Update, then repair the installation
EOF
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      exit 2
      ;;
  esac
done

mkdir -p "$LOG_DIR"
exec >>"$LOG_FILE" 2>&1

echo
printf '[%s] Pulse %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$MODE"

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="${PULSE_REPO_DIR:-$(cd "$(dirname "$SCRIPT_PATH")/../.." && pwd)}"

if [[ ! -d "$REPO_DIR/.git" ]]; then
  echo "Repository not found: $REPO_DIR"
  exit 1
fi

cd "$REPO_DIR"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Local changes detected in $REPO_DIR; refusing automatic update."
  exit 1
fi

before="$(git rev-parse HEAD)"
git fetch --quiet origin main
local="$(git rev-parse HEAD)"
remote="$(git rev-parse origin/main)"

if [[ "$local" != "$remote" ]]; then
  if ! git merge-base --is-ancestor "$local" "$remote"; then
    echo "Remote history diverged; refusing automatic update."
    exit 1
  fi
  git merge --ff-only origin/main
  echo "Repository updated $before -> $(git rev-parse HEAD)"
else
  echo "Repository is already current."
fi

repair_links() {
  local backup_dir="$HOME/.local/state/pulse/backups/repair-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$backup_dir"

  link_one() {
    local source="$1"
    local target="$2"

    if [[ -L "$target" && "$(readlink -f "$target")" == "$(readlink -f "$source")" ]]; then
      return
    fi

    if [[ -e "$target" || -L "$target" ]]; then
      mkdir -p "$(dirname "$backup_dir/$target")"
      mv "$target" "$backup_dir/$target"
    fi

    mkdir -p "$(dirname "$target")"
    ln -s "$source" "$target"
    echo "Linked $target -> $source"
  }

  local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
  for source in "$REPO_DIR/.config"/*; do
    [[ -e "$source" ]] || continue
    link_one "$source" "$config_dir/$(basename "$source")"
  done

  mkdir -p "$HOME/.local/bin"
  for source in "$REPO_DIR/local/bin"/*; do
    [[ -f "$source" ]] || continue
    link_one "$source" "$HOME/.local/bin/$(basename "$source")"
  done

  chmod +x "$REPO_DIR/local/bin/"* "$REPO_DIR/.config/hypr/scripts/"* 2>/dev/null || true

  if [[ -z "$(find "$backup_dir" -mindepth 1 -print -quit 2>/dev/null)" ]]; then
    rmdir "$backup_dir" 2>/dev/null || true
  else
    echo "Repair backup: $backup_dir"
  fi
}

if [[ "$MODE" == "fix" || "$MODE" == "update" ]]; then
  repair_links
fi

echo "Pulse installation is using the repository as its source of truth."
