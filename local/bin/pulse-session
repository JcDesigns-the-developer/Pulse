#!/usr/bin/env bash
set -euo pipefail

# Pulse session launcher for Hyprland 0.55+.
# start-hyprland is the supported compositor bootstrapper.

export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
export DESKTOP_SESSION="${DESKTOP_SESSION:-pulse}"
export MOZ_ENABLE_WAYLAND="${MOZ_ENABLE_WAYLAND:-1}"
export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"

# systemd-logind normally supplies XDG_RUNTIME_DIR. If the environment was
# lost (for example after using su), recover it only when systemd has already
# created a directory owned and writable by the current user. Never create
# /run/user manually.
if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
    candidate="/run/user/$(id -u)"

    if [[ -d "$candidate" && -O "$candidate" && -w "$candidate" ]]; then
        export XDG_RUNTIME_DIR="$candidate"
    else
        echo "Pulse: XDG_RUNTIME_DIR is not set and systemd did not provide a usable runtime directory." >&2
        echo "Log in through a normal systemd/PAM session and run pulse-session again." >&2
        exit 1
    fi
fi

if [[ ! -d "$XDG_RUNTIME_DIR" || ! -w "$XDG_RUNTIME_DIR" ]]; then
    echo "Pulse: XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR is missing or not writable." >&2
    exit 1
fi

if ! command -v start-hyprland >/dev/null 2>&1; then
    echo "Pulse: start-hyprland was not found in PATH." >&2
    echo "Install/update the Hyprland package." >&2
    exit 1
fi

exec start-hyprland "$@"
