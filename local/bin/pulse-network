#!/usr/bin/env bash
set -euo pipefail

# Pulse network control. NetworkManager is the primary backend because Pulse
# installs it system-wide; iwctl remains available for iwd-only setups.

if command -v nmcli >/dev/null 2>&1; then
    if command -v rofi >/dev/null 2>&1 && [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
        choice="$(printf '%s\n' \
            'Wi-Fi status' \
            'Scan networks' \
            'Connect to network' \
            'Toggle Wi-Fi' \
            'NetworkManager status' \
            | rofi -dmenu -i -p 'Pulse Network')" || true

        case "$choice" in
            'Wi-Fi status')
                nmcli device wifi
                ;;
            'Scan networks')
                nmcli device wifi rescan >/dev/null 2>&1 || true
                nmcli device wifi list
                ;;
            'Connect to network')
                ssid="$(nmcli -t -f SSID device wifi list | sed '/^$/d' | rofi -dmenu -i -p 'Wi-Fi')" || true
                [[ -z "$ssid" ]] && exit 0
                password="$(rofi -dmenu -password -p 'Password')" || true
                [[ -z "$password" ]] && exit 0
                nmcli device wifi connect "$ssid" password "$password"
                ;;
            'Toggle Wi-Fi')
                state="$(nmcli radio wifi)"
                if [[ "$state" == "enabled" ]]; then
                    nmcli radio wifi off
                else
                    nmcli radio wifi on
                fi
                ;;
            'NetworkManager status')
                nmcli general status
                nmcli device
                ;;
            *)
                exit 0
                ;;
        esac
        exit 0
    fi

    exec nmcli device wifi
fi

if command -v iwctl >/dev/null 2>&1; then
    exec iwctl
fi

echo 'Pulse: neither nmcli nor iwctl is installed.' >&2
exit 1
