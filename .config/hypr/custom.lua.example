-- Pulse Ghost machine-local override template.
-- Copy this file to ~/.config/hypr/custom.lua.
-- Pulse loads the normal modules first, then this file last.
-- Put personal monitors, keybinds, rules, and hardware-specific changes here.

-- Monitor example:
-- hl.monitor({
--     output = "DP-1",
--     mode = "1920x1080@165",
--     position = "0x0",
--     scale = 1,
-- })

-- Personal bind example:
-- hl.bind(
--     "SUPER + SHIFT + O",
--     hl.dsp.exec_cmd("your-command"),
--     { description = "Run my command" }
-- )

-- Personal rule example:
-- hl.window_rule({
--     name = "my-floating-window",
--     match = { class = "^my-app$" },
--     float = true,
-- })

-- The normal Pulse modules are still available with require(), for example:
-- local theme = require("pulse.theme")
