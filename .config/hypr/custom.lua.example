-- Pulse Ghost machine-local override template.
-- Copy to ~/.config/hypr/custom.lua.
-- Built-in Pulse modules load first; this file loads last.
--
-- Prefer the Pulse API below instead of reaching into Pulse's internal files.
-- This keeps hardware and personal settings separate from the distro.

local Pulse = require("pulse")
local Theme = Pulse.load("theme")

