configuration {
    show-icons: true;
    display-drun: "Applications";
    drun-display-format: "{name}";
}

* {
    bg: #08080a;
    panel: #101014;
    red: #d0002b;
    text: #f2f2f2;
    muted: #8a8a8a;
}

window {
    width: 620px;
    border: 2px;
    border-color: @red;
    border-radius: 10px;
    background-color: @bg;
    padding: 12px;
}

mainbox { children: [ "inputbar", "message", "listview" ]; spacing: 10px; }
inputbar { background-color: @panel; border-radius: 7px; padding: 10px; }
prompt { text-color: @red; }
entry { text-color: @text; placeholder: "Search applications"; placeholder-color: @muted; }
listview { columns: 2; lines: 6; spacing: 6px; fixed-height: false; }
element { padding: 9px; border-radius: 7px; background-color: transparent; }
element selected { background-color: @red; text-color: #ffffff; }
element-text { text-color: @text; vertical-align: 0.5; }
element-icon { size: 32px; }
message { text-color: @muted; }
