configuration {
    modi: "drun,run,window";
    show-icons: true;
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 11";
}

* {
    bg: #09090b;
    fg: #eeeeee;
    accent: #d0002b;
    border: #3a111b;
}

window { width: 620px; border: 2px; border-color: @border; background-color: @bg; }
mainbox { padding: 12px; }
inputbar { padding: 8px; children: [ prompt, entry ]; }
prompt { text-color: @accent; }
entry { text-color: @fg; }
listview { lines: 8; columns: 1; spacing: 5px; padding: 8px 0 0; }
element { padding: 8px; }
element selected { background-color: @accent; text-color: #ffffff; }
